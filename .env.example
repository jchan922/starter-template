# ─────────────────────────────────────────────────────────
# CLIENT SAFE — VITE_ prefix exposes these to the browser bundle
# Safe to use in React components via import.meta.env.VITE_*
# Do NOT put secrets here — they will be visible in the browser
# ─────────────────────────────────────────────────────────

VITE_APP_NAME=MyApp
# Display name of the application

VITE_API_URL=https://api.yourapp.com
# Base URL for your backend API

VITE_STRIPE_PUBLIC_KEY=pk_test_
# Stripe publishable key — safe to expose, client-side only

VITE_AUTH_URL=https://auth.yourapp.com
# Base URL for auth service

VITE_ENABLE_ANALYTICS=false
# Feature flag — enable/disable analytics (true | false)


# ─────────────────────────────────────────────────────────
# SERVER ONLY — no VITE_ prefix
# Never exposed to the browser
# These are used in server-side code and build pipelines only
# ─────────────────────────────────────────────────────────

STRIPE_SECRET_KEY=
# Stripe secret key — server only, never expose to client

DATABASE_URL=
# Full database connection string
# Mongo:    mongodb+srv://user:pass@cluster.mongodb.net/dbname
# Postgres: postgresql://user:pass@host:5432/dbname

AUTH_SECRET=
# Random secret for signing session tokens (min 32 chars)
# Generate: openssl rand -base64 32

EMAIL_API_KEY=
# Email provider API key (Resend, Postmark, SendGrid)


# ─────────────────────────────────────────────────────────
# ENVIRONMENT FLAGS
# ─────────────────────────────────────────────────────────

NODE_ENV=development
# Runtime environment (development | production | test)
